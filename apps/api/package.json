{
  "name": "@app/api",
  "private": true,
  "type": "module",
  "exports": {
    "./app": "./src/app.ts",
    "./schemas": "./src/schemas/index.ts"
  },
  "scripts": {
    "dev": "TRUST_PROXY=1 DATABASE_URL=${DATABASE_URL:-postgres://app:app@localhost:${POSTGRES_PORT:-5432}/app} SMTP_PORT=${SMTP_PORT:-${MAILPIT_SMTP_PORT:-1025}} PUBLIC_URL=${PUBLIC_URL:-http://localhost:${WEB_PORT:-5173}} tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "test": "vitest run",
    "typecheck": "tsc -p .",
    "db:generate": "drizzle-kit generate",
    "admin:create": "tsx src/scripts/admin-create.ts",
    "db:seed": "tsx src/scripts/db-seed.ts",
    "db:reset": "tsx src/scripts/db-reset.ts"
  },
  "dependencies": {
    "@date-fns/tz": "^1.5.0",
    "@hono/node-server": "^2.1.5",
    "@hono/zod-validator": "^0.9.1",
    "date-fns": "^4.4.0",
    "drizzle-orm": "0.45.4",
    "hono": "^4.13.13",
    "hono-rate-limiter": "~0.5.4",
    "nodemailer": "^10.1.7",
    "postgres": "3.4.9",
    "tsx": "^4.23.15",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "drizzle-kit": "0.31.11",
    "typescript": "~6.0.3",
    "vitest": "^5.0.5"
  }
}
